sequenceDiagram
    participant Client
    participant A as Provider
    participant Cache as moka Cache
    participant mpscChannel@{"type": "queue"} as MPSC Channel
    participant batchWorker as Batch Worker
    participant Fetcher
    participant Sink
    participant DB@{"type": "database"}

    par Client
        Client->>A: get_or_schedule(keys) / get_or_fetch(keys)
        create participant known@{"type": "collections"} as Known
        A->>known: new()
        create participant unanswered@{"type": "collections"} as Unanswered keys
        A->>unanswered: new()

        loop for each key of keys
            A->>Cache: get(key)
            Cache-->>A: cache entry
            alt Some(Some(value))
                A->>known: insert(key, value)
            else Some(None)
                Note right of A: MX said it doesn't have it, recently enough:<br/>nothing to return, and nothing to ask
            else None
                A->>unanswered: push(key)
            end
        end

        destroy unanswered
        unanswered-->>A: unanswered

        opt unanswered is not empty
            alt get_or_schedule
                A->>mpscChannel: send(Schedule(unanswered))
                Note right of A: fire and forget: no reply channel,<br/>nothing is awaited but the send itself
            else get_or_fetch
                A->>mpscChannel: send(Fetch(unanswered, reply_tx))
                A->>A: await reply_rx
                Note right of A: waits for the batch, not ahead of it
            end
        end

        destroy known
        known-->>A: known
        A-->>Client: known

    and Batch Worker
        create participant Interval
        batchWorker->>Interval: new(flush_interval), first tick consumed
        loop Every batch
            create participant batch@{"type": "collections"} as Batch (keys + waiters)
            batchWorker->>batch: new()

            loop Batching
                Note over batchWorker: tokio::select!
                par
                    batchWorker->>mpscChannel: recv()
                    mpscChannel-->>batchWorker: s1 = pending { job }
                and
                    batchWorker->>Interval: tick()
                    Interval-->>batchWorker: s2 = pending
                end

                alt s1 finished first
                    alt Schedule / Fetch
                        batchWorker->>batch: take_job(job)
                        opt nothing sent for a whole window (or none ever)
                            batchWorker->>mpscChannel: drain what is already queued
                            batchWorker->>batchWorker: break
                        end
                    else Force
                        batchWorker->>batchWorker: spawn its own fetch, off the window
                    end
                else s2 finished first
                    batchWorker->>batchWorker: break
                end
            end

            destroy batch
            batch-->>batchWorker: batch
            opt batch is not empty
                batchWorker->>batchWorker: last fetch = now
                batchWorker->>Interval: reset()
                create participant fetchTask as Fetch task
                batchWorker->>fetchTask: spawn(batch)
                Note over batchWorker,fetchTask: spawned, not awaited: the worker keeps taking keys while MX is thinking
            end
        end
        destroy Interval
        Interval-->batchWorker: drop
    and Fetch task
        fetchTask->>Fetcher: fetch(batch.keys)
        activate Fetcher
        Note over Fetcher: as few requests as the endpoint allows, a bounded number in flight
        Fetcher-->>fetchTask: results = the keys MX has, with their value
        deactivate Fetcher

        alt results is error
            fetchTask->>fetchTask: log error, and tell the waiters
            Note right of fetchTask: nothing is written down, so these keys<br/>are asked again by the next call
        else
            loop for each key of batch.keys
                fetchTask->>Cache: insert(key, results.get(key))
                Note right of Cache: Some(value) expires after known_timeout<br/>None expires after unknown_timeout
            end
            fetchTask->>A: reply_tx.send(what each waiter asked for)
            destroy fetchTask
            fetchTask->>Sink: store(results)
            Sink->>DB: the query's own way of writing them down
        end
    end
